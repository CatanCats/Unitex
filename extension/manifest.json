{
  "manifest_version": 3,
  "name": "Unitex Helper",
  "version": "1.4.0",
  "description": "Lets Unitex show results from Google, Bing, Brave, Mojeek, Yandex and SearXNG, and products from Amazon, eBay and other stores, by loading their pages in your own browser.",
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.bing.com/*",
    "https://search.brave.com/*",
    "https://www.mojeek.com/*",
    "https://priv.au/*",
    "https://searx.be/*",
    "https://baresearch.org/*",
    "https://search.inetol.net/*",
    "https://paulgo.io/*",
    "https://yandex.com/*",
    "https://www.amazon.com/*",
    "https://www.amazon.com.au/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.ca/*",
    "https://www.ebay.com/*",
    "https://www.ebay.com.au/*",
    "https://www.ebay.co.uk/*",
    "https://www.ebay.ca/*",
    "https://www.argos.co.uk/*",
    "https://www.bestbuy.ca/*",
    "https://www.bestbuy.com/*",
    "https://www.bigw.com.au/*",
    "https://www.currys.co.uk/*",
    "https://www.gumtree.com/*",
    "https://www.gumtree.com.au/*",
    "https://www.harveynorman.com.au/*",
    "https://www.jbhifi.com.au/*",
    "https://www.johnlewis.com/*",
    "https://www.kijiji.ca/*",
    "https://www.kmart.com.au/*",
    "https://www.kogan.com/*",
    "https://www.noelleeming.co.nz/*",
    "https://www.officeworks.com.au/*",
    "https://www.pbtech.co.nz/*",
    "https://www.target.com/*",
    "https://www.thegoodguys.com.au/*",
    "https://www.thewarehouse.co.nz/*",
    "https://www.trademe.co.nz/*",
    "https://www.walmart.ca/*",
    "https://www.walmart.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://catancats.github.io/Unitex/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "unitex-helper@catancats.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "searchTerms"
        ]
      }
    }
  }
}
